# ---------------------------------------------------------------------------
# Memory Lane Collectables — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and set the same keys
# in Vercel (Project Settings -> Environment Variables) for the deployed site.
# `.env.local` is gitignored — never commit real secrets.
#
# Only the keys under "REQUIRED NOW" are needed to run the app today. Every
# other block is documented here so the integration work has a defined home;
# leave them blank until that phase is built. Code must read every one of
# these through a typed config module — never `process.env.X` scattered
# through components, and never a fallback that hard-codes a real value.
# ---------------------------------------------------------------------------


# === REQUIRED NOW =========================================================

# Supabase -> Project Settings -> API Keys -> "Publishable and secret" tab.
# The publishable key is safe in the browser; Row Level Security is the real
# protection. URL is Project Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret (service-role) key. SERVER ONLY — never prefixed NEXT_PUBLIC,
# never sent to the browser. Used by background jobs / server actions that must
# bypass RLS (e.g. writing AI results, the public reservation insert path).
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin, no trailing slash. Used for absolute URLs in
# sitemap.xml, robots.txt, OpenGraph tags and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# === MEDIA STORAGE ========================================================
# Supabase Storage is used by default (same project). These only need setting
# if media is moved to a dedicated bucket/CDN or an external provider later.
# Bucket names the app expects:
#   clearance-media   (raw uploads: photos + video walkthroughs, private)
#   item-photos       (per-item originals, private)
#   listing-images    (processed/derived public images)
SUPABASE_STORAGE_URL=


# === AI PROVIDERS =========================================================
# Vision identification, listing copy, valuation reasoning. Behind a provider
# abstraction (lib/ai/*) — Claude is the default; others are optional and
# selected via AI_*_PROVIDER. Missing key => that provider reports
# "Connection required" and the mock/dev adapter is used instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

AI_VISION_PROVIDER=claude          # claude | openai | gemini | mock
AI_VISION_MODEL=claude-opus-5      # claude-opus-5 (best) | claude-sonnet-5 (~2.5x cheaper)
AI_LISTING_WRITER_PROVIDER=claude  # claude | openai | gemini | mock
AI_VALUATION_PROVIDER=mock         # claude | openai | gemini | mock

# Optional dedicated OCR provider for hallmarks / makers' marks / labels.
OCR_PROVIDER=none                  # none | google-vision | aws-textract
GOOGLE_VISION_API_KEY=


# === BACKGROUND JOBS =====================================================
# Video frame extraction + bulk AI runs are async. Default runner is an
# in-process queue backed by Postgres; set a Redis URL to use a real queue.
JOB_QUEUE_DRIVER=postgres          # postgres | redis
REDIS_URL=

# ffmpeg binary for video frame extraction (leave blank to use bundled).
FFMPEG_PATH=


# === PAYMENTS — Stripe Checkout (live) ==================================
# "Buy it now" per item. Card data never touches our servers — Stripe hosts
# the checkout page. Test mode (sk_test_… + a test webhook secret) works
# end-to-end with card 4242 4242 4242 4242. Leave blank => the shop shows
# "Reserve" instead of "Buy it now".
#   STRIPE_SECRET_KEY      sk_test_… or sk_live_…  (Dashboard → Developers → API keys)
#   STRIPE_WEBHOOK_SECRET  whsec_…                 (Developers → Webhooks → your endpoint)
#     endpoint URL: <site>/api/stripe/webhook, event: checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# === MARKETPLACE CHANNELS ================================================
# Each channel has an integration level: full-api | assisted | export.
# Where credentials/partnership don't exist yet, the channel runs in
# "assisted" or "export" mode and the UI says so — it must never fake a
# publish. See MEMORYLANE_MASTER_PLAN.md "Sales channel adapters".

# eBay (Browse API = active listings only; Sell API needs a dev account).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_ENVIRONMENT=sandbox           # sandbox | production

# Etsy (Open API v3 — OAuth2, per-shop).
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Facebook Marketplace + Vinted: no general listing API. Always assisted /
# export. No keys — listed here so nobody goes looking for them.


# === EMAIL ===============================================================
# Reservation confirmations, "we're interested" replies for Sell to Us,
# staff notifications. Transactional only.
EMAIL_PROVIDER=none                # none | resend | postmark | ses
RESEND_API_KEY=
EMAIL_FROM="Memory Lane Collectables <hello@memorylanecollectables.co.uk>"


# === ANALYTICS (optional) ===============================================
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
